# ---- Backend парковки ------------------------------------------------------
BACKEND_BASE_URL=http://localhost:8000
MAX_CORRECTIONS_TO_TRUST=2

# ---- Какая камера обслуживает какие ворота: usb | ip ------------------------
CAMERA_ENTRY_SOURCE=usb
CAMERA_EXIT_SOURCE=ip

# ---- Общие параметры камер ---------------------------------------------------
CAMERA_WARMUP_FRAMES=5            # кадров выбрасывается после (пере)подключения
CAMERA_CAPTURE_DELAY_SECONDS=0    # пауза после сигнала датчика перед съёмкой
CAMERA_FIXTURE_FALLBACK=true      # при недоступной камере брать fixtures/*.jpg (для разработки; в проде лучше false)

# ---- Камера 1: телефон, транслирующий видео по IP в локальной сети ----------
# Android «IP Webcam»: http://<ip>:8080/video    DroidCam: http://<ip>:4747/video
# RTSP-приложения:     rtsp://<ip>:8554/live     (логин/пароль можно вписать в URL)
# Включается автоматически, если задан CAMERA_IP_URL (или явно CAMERA_IP_ENABLED=true/false).
CAMERA_IP_URL=
# CAMERA_IP_ENABLED=true
CAMERA_IP_RTSP_TRANSPORT=tcp      # tcp | udp (только для rtsp://)
CAMERA_IP_OPEN_TIMEOUT_MS=5000
CAMERA_IP_READ_TIMEOUT_MS=5000
CAMERA_IP_RECONNECT_MIN_DELAY=1   # пауза между попытками растёт 1,2,4,... до MAX
CAMERA_IP_RECONNECT_MAX_DELAY=30
CAMERA_IP_STALL_TIMEOUT=5         # секунд без кадров -> переподключение
CAMERA_IP_FRAME_TIMEOUT=5         # сколько запрос ждёт свежий кадр

# ---- Камера 2: телефон по USB, определяемый системой как камера -------------
# Найти индекс: python scripts/find_cameras.py --backend msmf --backend dshow --save snapshots
CAMERA_USB_ENABLED=true
CAMERA_USB_INDEX=auto             # число или auto (перебор 0..SCAN_LIMIT-1)
CAMERA_USB_IGNORE_INDEXES=        # например 0 — пропустить встроенную веб-камеру при auto
CAMERA_USB_SCAN_LIMIT=8
CAMERA_USB_BACKEND=auto           # auto | dshow | msmf | v4l2 | any   (auto: Windows=dshow, Linux=v4l2)
CAMERA_USB_WIDTH=0                # 0 = по умолчанию драйвера; для номеров лучше 1280x720 и выше
CAMERA_USB_HEIGHT=0
CAMERA_USB_FOURCC=                # например MJPG — выше разрешение/частота по USB
CAMERA_USB_RECONNECT_MIN_DELAY=1
CAMERA_USB_RECONNECT_MAX_DELAY=30
CAMERA_USB_STALL_TIMEOUT=5
CAMERA_USB_FRAME_TIMEOUT=5

# ---- Распознавание -----------------------------------------------------------
PLATE_COUNTRY_CODE=KG             # две буквы страны на номере; пусто = принимать любые две буквы
OCR_PRELOAD=true                  # загрузить модель при старте, а не при первом запросе
OCR_GPU=false
OCR_MIN_SLOT_CONFIDENCE=0.0       # 0 = выключено; см. README, раздел «Оценка качества OCR»
OCR_MIN_SEGMENTATION_SCORE=0.35
