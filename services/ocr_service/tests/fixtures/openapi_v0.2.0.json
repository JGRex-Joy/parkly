    "/debug/camera-snapshot": {
      "get": {
        "operationId": "camera_snapshot_debug_camera_snapshot_get",
        "parameters": [
          {
            "in": "query",
            "name": "gate",
            "required": true,
            "schema": {
              "enum": [
                "entry",
                "exit"
              ],
              "title": "Gate",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CameraSnapshotResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "DEBUG: посмотреть, что именно видит камера (без распознавания, без сохранения на диск)"
      }
    },
